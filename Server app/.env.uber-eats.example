# Configuración de Uber Eats API
# ==================================
# 
# Para obtener estas credenciales:
# 1. Visita https://developer.uber.com/
# 2. Crea una aplicación para "Uber Eats"
# 3. Configura los permisos para Marketplace API
# 4. Copia las credenciales aquí

# Credenciales de autenticación OAuth 2.0
UBER_EATS_CLIENT_ID=EsXBQrBR3Z990kg7MFXINVgURoUMlsiv
UBER_EATS_CLIENT_SECRET=H9LcaOrKKIhsO9uCO3AjXClfmWZFmLPpNmPMKzdJ
UBER_EATS_ACCESS_TOKEN=your_access_token_here

# ID de tu tienda/restaurante en Uber Eats
UBER_EATS_STORE_ID=your_store_id_here

# URL base de la API (usar sandbox para testing)
UBER_EATS_API_URL=https://api.uber.com
# Para testing: https://sandbox-api.uber.com

# Secret para validar webhooks (opcional pero recomendado)
UBER_EATS_WEBHOOK_SECRET=your_webhook_secret_here

# URL del webhook para recibir notificaciones en tiempo real
# Debe ser una URL pública accesible por Uber Eats
UBER_EATS_WEBHOOK_URL=https://posfagotto.cl/api/uber-eats/webhook

# Configuración de notificaciones
UBER_EATS_NOTIFICATIONS_ENABLED=true
UBER_EATS_SOUND_NOTIFICATIONS=true

# Configuración de logging
UBER_EATS_LOG_LEVEL=info
UBER_EATS_LOG_ORDERS=true

# ==================================
# Instrucciones de configuración:
# 
# 1. Copia este archivo como .env y reemplaza los valores
# 2. Obtén las credenciales desde https://developer.uber.com/
# 3. Configura el webhook URL en tu panel de Uber Eats
# 4. Asegúrate de que tu servidor sea accesible públicamente para webhooks
# 5. Reinicia el servidor después de modificar las variables
# ==================================
