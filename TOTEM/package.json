{
  "name": "totem-fagotto",
  "version": "1.0.0",
  "description": "Sistema TOTEM - Mercado Pago Point Smart para Fagotto",
  "main": "electron/main.js",
  "author": "Fagotto",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.fagotto.totem",
    "productName": "TOTEM Fagotto",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "totem.html",
      "enviar-pago-web.php",
      "validar-pago.php",
      "webhook-point.php",
      "ver-mi-terminal.php",
      "config.php",
      ".env",
      "vendor/**/*",
      "storage/**/*"
    ],
    "extraResources": [
      {
        "from": "php",
        "to": "php",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TOTEM Fagotto"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "electron/assets/icon.png",
      "category": "Office"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "express": "^4.18.2",
    "php-server": "^0.2.0",
    "find-free-port": "^2.0.0"
  }
}
